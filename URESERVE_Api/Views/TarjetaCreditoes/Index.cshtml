@model IEnumerable<Data.Models.TarjetaCredito>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.numeroTarjeta)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.nombreTitular)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.fechaVencimiento)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.codigoSeguridad)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.numeroTarjeta)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.nombreTitular)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.fechaVencimiento)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.codigoSeguridad)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.TarjetaCreditoId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.TarjetaCreditoId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.TarjetaCreditoId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
